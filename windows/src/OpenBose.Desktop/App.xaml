<Application x:Class="OpenBose.Desktop.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#12243A"/>
    <SolidColorBrush x:Key="Accent" Color="#43C9FF"/>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="15,7"/>
      <Setter Property="Margin" Value="0,8,8,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="#234766"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#4982A8"/>
    </Style>
  </Application.Resources>
</Application>
