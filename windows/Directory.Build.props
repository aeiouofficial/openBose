<Project>
  <!-- All .NET build outputs remain inside the OpenBose workspace. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.tmp\dotnet\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.tmp\dotnet\bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
