<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OpenBose.Protocol/OpenBose.Protocol.csproj" />
    <None Include="../../../spec/bmap/*.json" CopyToOutputDirectory="Always" Link="spec/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
